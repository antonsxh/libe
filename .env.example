# Postgres (matches compose.yaml; for `bun run db:dev` use postgres://libe:libe@127.0.0.1:54330/libe)
DATABASE_URL="postgres://libe:libe@localhost:5432/libe"

# Pairs the first device on /setup (and recovers access later). Required by compose.yaml.
# Generate one with: openssl rand -base64 24
LIBE_SETUP_SECRET="change-me-to-a-long-random-secret"

# Public URL of the app (compose.yaml → ORIGIN). Use the https URL in production.
# LIBE_ORIGIN="https://libe.example.com"

# Domain for the optional Caddy HTTPS proxy (compose.caddy.yaml).
# LIBE_DOMAIN="libe.example.com"
