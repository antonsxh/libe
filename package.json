{
	"name": "libe",
	"version": "0.1.1-nightly.20261126.56",
	"private": true,
	"packageManager": "bun@1.4.5",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "bun run scripts/migrate.ts && bun build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker && tsc -p e2e",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"test": "bun test src scripts",
		"test:e2e": "vite build && playwright test -c e2e/playwright.config.ts --project=desktop",
		"test:e2e:mobile": "vite build && playwright test -c e2e/playwright.config.ts --project=mobile-iphone --project=mobile-ipad",
		"test:tauri": "vite build && tauri build --debug --no-bundle && xvfb-run -a -s '-screen 0 1400x960x24' playwright test -c e2e/tauri/playwright.config.ts",
		"format": "prettier --write .",
		"db:up": "docker compose up -d db",
		"db:dev": "scripts/dev-db.sh",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run scripts/migrate.ts",
		"db:seed": "bun run scripts/seed.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build"
	},
	"dependencies": {
		"@fontsource-variable/geist": "5.3.0",
		"@lucide/svelte": "^1.75.0",
		"drizzle-orm": "^0.45.4",
		"postgres": "^4.1.1",
		"qrcode-generator": "^2.0.4"
	},
	"devDependencies": {
		"@playwright/test": "1.56.1",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.12.6",
		"@types/bun": "^1.4.4",
		"@types/node": "^24",
		"@types/selenium-webdriver": "^4.35.7",
		"drizzle-kit": "^0.31.11",
		"jsqr": "1.4.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"selenium-webdriver": "4.53.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	}
}
