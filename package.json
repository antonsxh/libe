{
	"name": "libe",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "bun run scripts/migrate.ts && bun build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"test": "bun test src",
		"format": "prettier --write .",
		"db:up": "docker compose up -d db",
		"db:dev": "scripts/dev-db.sh",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run scripts/migrate.ts",
		"db:seed": "bun run scripts/seed.ts",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@lucide/svelte": "^1.75.0",
		"drizzle-orm": "^0.45.4",
		"postgres": "^4.1.1",
		"qrcode-generator": "^2.0.4"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.12.6",
		"@types/bun": "^1.4.4",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.11",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	}
}
